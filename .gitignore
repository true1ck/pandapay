PandaPal_Auth_Service/

# Node
node_modules/

# Flutter/Dart (top-level catch-all; each package also has its own)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/


# Node service secrets — never commit real or dev JWT secrets
auth/.env
api/.env
scraper/.env

# Root-level env files for docker-compose.prod.yml / docker-compose.staging.yml
# — real secrets. The .example templates ARE meant to be committed.
/.env
/.env.prod
/.env.staging

# Python
scraper/.venv/
__pycache__/
*.pyc
.pytest_cache/
.design_preview/
/.pub-cache/
/.appdata/

# macOS
.DS_Store

# Local test/QA screenshots
session_screenshots/

# Local agent/audit artifacts and generated analysis caches
.codex-tmp/
outputs/
**/graphify-out/
**/.gradle/

# Local emulator inspection output
app/emulator_screen_*.png
**/window_dump.xml
app/third_party/telephony/android/.gradle/

# SSH / signing keys. NOTHING matching these may ever be committed — a
# private key in a public repo is a full server compromise, and git history
# keeps it long after the file is deleted.
#
# Added after `PEM_PandaPay/` (a live Oracle Cloud SSH key for the
# production backend) was found sitting untracked in the repo root, one
# `git add .` away from being published.
*.pem
*.key
!*.pub
PEM_PandaPay/
**/pem/
*.p12
*.jks
*.keystore
