            },
            {
              "url": "https://campaign.axis.bank.in/generic/terms-and-conditions-generic-all.pdf",
              "kind": "Axis revision notice effective 28-08-2026 linked from the Kwik page banner (DCC markup 3.5%, late fee above ₹50,000, payment allocation, gift card category; nothing on Kwik earn)",
