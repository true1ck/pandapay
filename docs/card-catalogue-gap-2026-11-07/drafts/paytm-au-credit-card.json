  "additional_data": {
    "_notes": "Source-supported data that cannot be represented faithfully by any existing universal schema field. Do not duplicate data already represented elsewhere. Do not use this section for unknown values, assumptions, or inferred data.",
    "items": [
      {
        "key": "official_research",
        "value": {
          "checked_on": "2026-11-05",
          "source_urls": [
            "https://www.au.bank.in/personal-banking/credit-cards/paytm-au-credit-card"
          ],
          "facts": [
            "Issuer page advertises up to 2% rewards on Paytm UPI and 5% on selected Paytm spends.",
            "One reward point redeems as INR 1 for Paytm Gold or INR 0.50 for other categories."
          ]
        }
      },
      {
        "key": "research_provenance",
        "value": {
          "research_method": "issuer pages read in a real browser session or issuer PDFs read with pdftotext; no model summaries used as facts",
          "fetched_on": "2026-11-07",
          "sources": [
            {
              "url": "https://www.au.bank.in/personal-banking/credit-cards/paytm-au-credit-card",
              "kind": "issuer_page + FAQ",
              "read": "rendered page text"
            },
            {
              "url": "https://www.au.bank.in/pdf/Paytm-AU-Credit-Card-Rewards-TCs.pdf",
              "kind": "Reward Point Usage T&C (earn rules, cap, exclusions)",
              "read": "pdftotext"
            },
            {
              "url": "https://www.au.bank.in/pdf/credit-card/Schedule-of-Charges-CC.pdf",
              "kind": "KFS",
              "date": "Key Fact Statement v1.9, 2 Nov 2026"
            }
          ],
          "open_questions": [
            "Network: RuPay Platinum is printed on the card image shown on the AU product page (\"Paytm RuPay Platinum\" art with the RuPay Platinum logo); the UPI-linked earn rules fit RuPay. The page also carries a shared \"Visa Cardholders\" offers popup (MakeMyTrip, Times Prime, Alaya Stays) which looks like a shared block rather than a statement about this card; whether a Visa variant also exists is not stated, so only RuPay is set.",
            "The 5-point merchant ID list is agreed between Paytm and AU and is not published.",
            "Lounge: 12 complimentary domestic lounge accesses are stated, but the period they run over (year, card year or total) is not.",
            "Reward Point Usage T&C carries no revision date.",
