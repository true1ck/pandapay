  "additional_data": {
    "_notes": null,
    "items": [
      {
        "key": "merchant_emi_processing_fee_rule",
        "value": {
          "rule": "1.5% of the amount or ₹150, whichever is higher, on every EMI conversion made at the merchant at the time of the transaction (SOC; MITC). GST at 18% applies.",
          "note": "The universal field holds a flat rupee amount only, so merchant_instant_emi_processing_fee_inr is left null."
        }
      },
      {
        "key": "late_payment_fee_rule",
        "value": {
          "rule": "12.5% of the outstanding amount (statement total amount due less net payments), minimum ₹5, maximum ₹1,300; GST at 18% on top",
          "source": "SOC; MITC section v, applicable from 17 Oct 2025",
          "grace": "The fee is levied only when the account stays past due for more than three days after the payment due date (MITC section v-d).",
          "note": "A percentage fee cannot be written as fixed slabs, so late_payment_slabs is empty."
        }
      },
      {
        "key": "miles_transfer_limits",
        "value": {
          "source": "Miles Transfer Programme T&C (PDF created 2026-08-18)",
          "rule": "No minimum, points must be a multiple of the ratio; up to 50,000 points per request and at most 2 requests per cardholder per month; primary cardholder only; transfers are final; credited usually in 3 business days and up to 10; turnaround_days holds the per-partner maximum (1 or 10 working days).",
          "not_modelled": "The universal partner_transfers row has no cap per month, so the 2 x 50,000 monthly limit is kept here."
        }
      },
      {
        "key": "addon_card_fee_rule",
        "value": {
          "rule": "MITC: ₹200 annual fee per add-on cardholder. The lounge benefit does not apply to add-on cards (T&C 3.3).",
          "source": "MITC section iii"
        }
      },
      {
        "key": "miles_transfer_fee",
        "value": {
          "rule": "A redemption fee of ₹99 + tax is levied on a World Safari Plus miles transfer request; the Miles Transfer T&C says this is the only card it applies to there.",
          "source": "Miles Transfer Programme T&C section 4"
        }
      },
