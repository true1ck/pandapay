{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandapay.app/schemas/portable-backup/export-envelope-v1.schema.json",
  "title": "PandaPay portable backup server export envelope v1",
  "description": "Typed NDJSON records emitted by the authenticated server snapshot endpoint.",
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/footer" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["type", "media_type", "format_version", "schema_version", "backup_id", "account_id", "snapshot_at", "snapshot_revision", "sections", "complete"],
      "properties": {
        "type": { "const": "header" },
        "media_type": { "const": "application/vnd.pandapay.portable-backup+ndjson" },
        "format_version": { "const": 1 },
        "schema_version": { "const": 1 },
        "backup_id": { "type": "string", "format": "uuid" },
        "account_id": { "type": "string", "format": "uuid" },
        "snapshot_at": { "type": "string", "format": "date-time" },
        "snapshot_revision": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "complete": { "const": false }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["type", "section", "record"],
      "properties": {
        "type": { "const": "record" },
        "section": { "type": "string", "minLength": 1 },
        "record": { "type": "object" }
      },
      "additionalProperties": false
    },
    "section_stat": {
      "type": "object",
      "required": ["count", "plaintext_bytes", "sha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "plaintext_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "required": ["type", "complete", "sections", "total_records", "total_plaintext_bytes", "duration_ms"],
      "properties": {
        "type": { "const": "footer" },
        "complete": { "const": true },
        "sections": { "type": "object", "additionalProperties": { "$ref": "#/$defs/section_stat" } },
        "total_records": { "type": "integer", "minimum": 0 },
        "total_plaintext_bytes": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
