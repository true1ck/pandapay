# Copy to .env and fill in. Never commit the real .env.

# IMPORTANT: must NOT be the `postgres` superuser role. Superusers bypass
# Postgres Row Level Security entirely (rolbypassrls), which silently makes
# every policy in db/supabase/migrations/0011_rls_policies.sql a no-op —
# discovered the hard way this session (see PROGRESS.md). Run
# db/setup_app_role.sql once against the `pandapay` database to create the
# `app_user` role this should actually connect as.
DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:55432/pandapay
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# Must match auth/'s JWT_ACCESS_SECRET exactly — this service verifies
# auth/'s tokens by signature only (see src/auth.js for why issuer/audience
# checks are deliberately NOT used here).
JWT_ACCESS_SECRET=

# Private API-to-auth session verification. These values are backend-only.
AUTH_INTERNAL_BASE_URL=http://localhost:3210
AUTH_INTERNAL_SERVICE_SECRET=

# Server-only signing keys for referral identity claims, invitation previews,
# and short-lived engagement receipts. Generate each independently.
REFERRAL_IDENTITY_HMAC_KEY=
REFERRAL_IDENTITY_HMAC_KEY_VERSION=v1
REFERRAL_PREVIEW_SECRET=
ENGAGEMENT_RECEIPT_SECRET=
REWARD_WORKER_INTERNAL_SECRET=
REWARD_WORKER_API_URL=http://api:4000
REWARD_WORKER_POLL_INTERVAL_MS=5000
REWARD_WORKER_BATCH_SIZE=5
REWARD_WORKER_LEASE_SECONDS=90
PRODUCT_TERMS_VERSION=2026-08-07

PORT=4000

# Gemini worker (run `npm run worker:gemini` as a separate process). Keep the
# provider key and worker bearer token server-side; neither belongs in Flutter.
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_WORKER_TOKEN=
AI_WORKER_API_BASE_URL=http://127.0.0.1:4000
AI_WORKER_INTERVAL_MS=1000
AI_WORKER_BATCH_MAX=4
AI_WORKER_BATCH_WINDOW_MS=300
AI_PROVIDER_TIMEOUT_MS=20000
# Conservative application-side ceilings; set these at or below the quotas
# configured for the single Gemini project. Provider 429 responses still use
# the durable retry path because quotas may change or include other callers.
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_TOKENS_PER_MINUTE=12000
GEMINI_REQUESTS_PER_DAY=20

# Required to enable privacy-preserving cross-user SMS correction signals.
# Use a random 32+ character server-only secret; rotating it starts a new
# sender-fingerprint cohort. This key is never sent to the app or Gemini.
SMS_LEARNING_HMAC_KEY=

# NODE_ENV=production makes src/config.js also require the three secrets
# below at startup (they're optional in dev — several routes have an
# explicit, intentional fallback when they're unset; see each route's own
# comment). Leave NODE_ENV unset for local dev.
NODE_ENV=

# Shared secret the partner/affiliate webhook caller must present.
# POST /partner-conversions/webhook returns 503 without this set.
PARTNER_WEBHOOK_SECRET=

# Shared secret an inbound-email provider (SendGrid/Mailgun/Postmark/a
# Cloudflare Email Worker) must present to POST /inbound-emails/webhook.
INBOUND_EMAIL_WEBHOOK_SECRET=

# pgp_sym_decrypt key for stored IMAP app passwords (F7 import). Without
# this, POST /imap-connections/:id/test falls back to a format-only check
# instead of a real IMAP login — fine for local dev, not for anything real.
IMAP_ENCRYPTION_KEY=

# Optional private notification service integration. Keep the project key on
# the PandaPay API server; never put it in Flutter or a public client bundle.
NOTIFICATION_SERVICE_URL=http://localhost:3100
NOTIFICATION_SERVICE_API_KEY=
NOTIFICATION_SERVICE_TIMEOUT_MS=4000
NOTIFICATION_SERVICE_FCM_INTEGRATION_IDENTIFIER=
NOTIFICATION_SERVICE_WORKFLOW_IDENTIFIER=pandapay-push-notification
NOTIFICATION_SERVICE_WORKFLOW_NAME=PandaPay push notification
