# Copy to .env and fill in. Never commit the real .env.

# IMPORTANT: must NOT be the `postgres` superuser role. Superusers bypass
# Postgres Row Level Security entirely (rolbypassrls), which silently makes
# every policy in db/supabase/migrations/0011_rls_policies.sql a no-op —
# discovered the hard way this session (see PROGRESS.md). Run
# db/setup_app_role.sql once against the `pandapay` database to create the
# `app_user` role this should actually connect as.
DATABASE_URL=postgresql://app_user:app_user_dev_pw@localhost:55432/pandapay
DB_SSL=false

# Must match auth/'s JWT_ACCESS_SECRET exactly — this service verifies
# auth/'s tokens by signature only (see src/auth.js for why issuer/audience
# checks are deliberately NOT used here).
JWT_ACCESS_SECRET=

PORT=4000

# NODE_ENV=production makes src/config.js also require the three secrets
# below at startup (they're optional in dev — several routes have an
# explicit, intentional fallback when they're unset; see each route's own
# comment). Leave NODE_ENV unset for local dev.
NODE_ENV=

# Shared secret the partner/affiliate webhook caller must present.
# POST /partner-conversions/webhook returns 503 without this set.
PARTNER_WEBHOOK_SECRET=

# Shared secret an inbound-email provider (SendGrid/Mailgun/Postmark/a
# Cloudflare Email Worker) must present to POST /inbound-emails/webhook.
INBOUND_EMAIL_WEBHOOK_SECRET=

# pgp_sym_decrypt key for stored IMAP app passwords (F7 import). Without
# this, POST /imap-connections/:id/test falls back to a format-only check
# instead of a real IMAP login — fine for local dev, not for anything real.
IMAP_ENCRYPTION_KEY=
