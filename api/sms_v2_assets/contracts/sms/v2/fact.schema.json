                  "type": "fact.amount.minor_not_integer",
                  "minimum": "fact.amount.minor_not_positive"
                }
              }
            }
          },
          "x-codes": {
            "type": "fact.malformed",
            "contains": "fact.movement.posted_required"
          },
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "enum": [
                  "posted"
                ]
              }
            }
          }
        },
        "attrs": {
          "type": "object",
          "required": [
            "direction",
            "purpose",
            "rail"
