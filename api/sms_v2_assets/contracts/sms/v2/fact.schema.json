          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "debit",
                "credit"
              ],
              "x-code": "fact.movement.direction_invalid"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "purchase",
                "p2p",
                "atm",
                "salary",
                "interest",
                "refund",
                "cashback",
                "reversal",
                "fee",
                "emi",
                "card_payment",
                "wallet_topup",
                "investment",
                "bill_payment",
                "tax",
                "transfer",
                "dividend",
                "unknown"
              ],
              "x-code": "fact.movement.purpose_invalid"
            },
            "rail": {
              "type": "string",
              "enum": [
                "upi",
                "card",
                "imps",
                "neft",
                "rtgs",
                "cheque",
                "nach",
                "wallet",
                "cash",
                "unknown"
              ],
              "x-code": "fact.movement.rail_invalid"
            },
            "mandateRef": {
              "type": "string",
              "minLength": 1,
              "x-code": "fact.movement.mandateRef_invalid"
