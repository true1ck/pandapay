{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandapay.app/contracts/sms/v2/fact.schema.json",
  "title": "Fact v2",
  "type": "object",
  "required": [
    "contractVersion",
    "factId",
    "sourceKey",
    "factType",
    "observedAt",
    "occurredAt",
    "instrument",
    "counterparty",
    "amounts",
    "references",
    "attrs",
    "provenance",
    "evidence",
    "confidence"
  ],
  "x-required-codes": {
    "factType": "fact.type_unknown"
  },
  "properties": {
    "contractVersion": {
      "const": "2.0",
      "x-code": "fact.contract_version_invalid"
    },
    "factId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-code": "fact.fact_id_invalid"
    },
    "sourceKey": {
      "type": "string",
      "minLength": 1
    },
    "factType": {
      "type": "string"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/utcTime"
    },
    "occurredAt": {
      "$ref": "common.schema.json#/$defs/utcTimeOrNull"
    },
    "instrument": {
      "$ref": "common.schema.json#/$defs/instrumentMention"
    },
    "counterparty": {
      "$ref": "common.schema.json#/$defs/counterparty"
    },
    "amounts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/amount"
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upiRef": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "impsRef": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "neftUtr": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "rtgsUtr": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "umrn": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "chequeNo": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "txnId": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "asbaRef": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "x-code": "fact.references_invalid"
        }
      },
      "x-codes": {
        "additionalProperties": "fact.references_invalid",
        "type": "fact.references_invalid"
      }
    },
    "attrs": {},
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/span"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-code": "fact.confidence_invalid"
    }
  },
  "additionalProperties": false,
  "allOf": [
