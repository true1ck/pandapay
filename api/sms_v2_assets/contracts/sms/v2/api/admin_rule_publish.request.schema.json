{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandapay.app/contracts/sms/v2/api/admin_rule_publish.request.schema.json",
  "title": "POST /admin/sms/v2/rules/:id/publish request",
  "type": "object",
  "required": [
    "version",
    "cohort",
    "goldenReport"
  ],
  "additionalProperties": false,
  "x-required-codes": {
    "goldenReport": "request.admin_rule_publish.golden_report_required"
  },
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cohort": {
      "type": "string",
      "enum": [
        "testers",
        "pct5",
        "pct25",
        "all"
      ],
      "x-code": "request.admin_rule_publish.cohort_invalid"
    },
    "goldenReport": {
      "type": "object"
    }
  }
}
