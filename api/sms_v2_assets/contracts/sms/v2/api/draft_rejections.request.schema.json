{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandapay.app/contracts/sms/v2/api/draft_rejections.request.schema.json",
  "title": "POST /sms/v2/draft-rejections request",
  "type": "object",
  "required": ["draftId", "reason"],
  "additionalProperties": false,
  "properties": {
    "draftId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "x-code": "request.draft_rejections.draft_id_invalid"
    },
    "reason": {
      "type": "string",
      "enum": ["no_match", "invalid_facts", "unsafe_rule"],
      "x-code": "request.draft_rejections.reason_invalid"
    }
  }
}
