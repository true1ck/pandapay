{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandapay.app/contracts/sms/v2/api/facts_batch.response.schema.json",
  "title": "POST /sms/v2/facts:batch response",
  "type": "object",
  "required": [
    "results",
    "serverTime"
  ],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "instrument",
              "event",
              "ledger"
            ],
            "x-code": "response.facts_batch.kind_invalid"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "rejected"
            ],
            "x-code": "response.facts_batch.status_invalid"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "serverTime": {
      "$ref": "../common.schema.json#/$defs/utcTime"
    }
  }
}
