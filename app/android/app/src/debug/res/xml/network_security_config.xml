<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (replaces src/main/res/xml/network_security_config.xml).
  The local dev servers (lib/app/env.dart defaults) speak plain HTTP on the
  host loopback alias. Release and profile builds never include this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
