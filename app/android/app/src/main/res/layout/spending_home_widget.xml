<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_compact_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_brand_mark"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="PandaPay"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_period_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="THIS MONTH  ·  SPENDING MIX"
                android:textColor="#8B8F94"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_spend_chart"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="Monthly spending by category"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_top_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#2B313A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_top_category_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="#59636C"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_rewards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#12805C"
            android:textSize="8sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_expanded_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Monthly spending categories"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
