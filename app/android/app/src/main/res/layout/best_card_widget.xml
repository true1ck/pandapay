<?xml version="1.0" encoding="utf-8"?>
<!--
  UA-8.2 (Chunk 32): home-screen widget layout skeleton — structurally
  present, never rendered/verified on a real device or emulator in this
  sandbox (no Android SDK/emulator here, same gap as UA-4/UA-5.3's other
  native plumbing). See PROGRESS.md.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Best card right now"
        android:textSize="11sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/widget_card_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="—"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/widget_card_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#333333" />

</LinearLayout>
