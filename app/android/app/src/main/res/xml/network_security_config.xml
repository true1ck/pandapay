<?xml version="1.0" encoding="utf-8"?>
<!--
  OWASP M5: every shipped build denies cleartext (HTTP) traffic and trusts only
  the system certificate store. The development loopback hosts (localhost and
  the emulator's 10.0.2.2) are allowed by src/debug/res/xml/network_security_config.xml,
  which replaces this file in debug builds only.

  When a real API domain is ready for certificate pinning, add a <pin-set> for
  that domain here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
