<?xml version="1.0" encoding="utf-8"?>
<!-- Without this, Android 8+ launchers fall back to shrinking the legacy
     square ic_launcher.png onto an auto-generated circle, which is why the
     mark rendered at roughly half size inside a pale ring. The background is
     the same white the artwork already sits on, so the two layers meet
     seamlessly under any launcher mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
