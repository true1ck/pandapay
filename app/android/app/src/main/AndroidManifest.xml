<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- UA-4 (Chunk 30, extended): camera/QR card scanning (mobile_scanner,
         camera + google_mlkit_text_recognition). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- The `camera` plugin (specifically camera_android_camerax) declares
         three permissions this screen has no use for: RECORD_AUDIO and
         WRITE_EXTERNAL_STORAGE (its own manifest scopes this one to
         maxSdkVersion 28) for its video-recording mode, and — confirmed by
         building a real prod-release APK and reading
         manifest-merger-prod-release-report.txt, not assumed —
         READ_EXTERNAL_STORAGE as well. This screen only ever calls
         takePicture() with CameraController(enableAudio: false): no video,
         no microphone, no gallery read. Stripped rather than carried: an
         unused microphone/storage permission on a card-scanning screen is
         exactly what Play Store review flags, and it's what
         scripts/check_prod_manifest.sh's denylist exists to catch — it did,
         on the first build after this pass added the plugin. -->
    <!-- Voice capture: requested only when the user taps/holds the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- UA-5.3 (Chunk 31): SMS-based transaction auto-import. Permission
         plumbing + BroadcastReceiver declaration only — same "could not be
         verified on a real device in this sandbox" caveat as UA-4's camera
         permissions above (no Android SDK/emulator/real SMS here either).
         See PROGRESS.md Chunk 31. READ_SMS lets the app read existing/
         historical messages (used for an opt-in onboarding backfill scan);
         RECEIVE_SMS is what lets the telephony plugin's BroadcastReceiver
         fire on newly-arriving bank SMS while the app is foregrounded. -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <!-- UA-8 (Chunk 32): "check nearby merchants" geofencing. Originally
         foreground-only (FINE/COARSE); extended in a later pass to add
         optional background monitoring — an opt-in toggle in
         nearby_merchants_screen.dart, off by default, backed by
         GeofenceMonitorService's geolocator position stream. ACCESS_BACKGROUND_LOCATION
         and the foreground-service permissions below are ONLY exercised
         when the user explicitly turns that toggle on; the default
         one-shot flow still only needs FINE/COARSE. Same "could not
         verify granting on a real device" caveat as UA-4/UA-5.3 above —
         no Android SDK/emulator here either. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Android 13+ runtime notification permission — flutter_local_notifications
         needs this to actually post the background-geofence-match alert
         (and the required persistent foreground-service notification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">
        <activity
            android:name="app.pandapay.pandapay.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Assistant links are delivered through MainActivity's typed
                 MethodChannel. Disable Flutter's generic deep-link parser so
                 a warm singleTop intent cannot push the raw pandapay:// URI
                 into GoRouter before the app validates and handles it. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Assistant/App Action fulfillment target. The app still owns
                 authentication and renders the actual spending report. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pandapay" android:host="assistant" android:pathPrefix="/spending" />
            </intent-filter>
            <!-- Public invite links. MainActivity forwards these through the
                 same validated MethodChannel as Assistant links because the
                 generic Flutter deep-link parser is intentionally disabled. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="pandapay.app"
                    android:pathPrefix="/i/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pandapay" android:host="i" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />

        <!-- Android's status-bar glyph is a small, monochrome mark rather than
             the full-color launcher artwork. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/pandapay_notification_small_icon" />

        <!-- Launcher widgets. Providers are exported so Android's widget host
             can send APPWIDGET_UPDATE and open each item in the picker. -->
        <receiver android:name="app.pandapay.pandapay.CombinedHomeWidgetProvider" android:label="PandaPay: Spending + Card" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/combined_home_widget_info" />
        </receiver>
        <receiver android:name="app.pandapay.pandapay.SpendingHomeWidgetProvider" android:label="PandaPay: Spending" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spending_home_widget_info" />
        </receiver>
        <receiver android:name="app.pandapay.pandapay.BestCardWidgetProvider" android:label="PandaPay: Card Pick" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/best_card_widget_info" />
        </receiver>

        <!-- The telephony plugin reaches its background Dart callback through
             this receiver. Without it, live SMS capture only works while a
             page happens to register a foreground listener. -->
        <receiver
            android:name="com.shounakmulay.telephony.sms.IncomingSmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- S2 (GAP_ANALYSIS.md §3): Quick Settings tile. -->
        <service
            android:name="app.pandapay.pandapay.BestCardTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="PandaPay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Scan-to-pay: enumerate installed UPI apps so the user can pick
             which one to hand a `upi://pay` intent to. Android 11+ hides
             other packages without this; QUERY_ALL_PACKAGES is not used
             (Play Store disallows it — and it would need a Play policy
             declaration anyway).

             The <intent> query alone was unreliable in the field: on a real
             device only Amazon Pay came back, while PhonePe / GPay / Paytm
             (which do handle `upi://pay`) stayed hidden — their manifest
             filters don't all match a scheme-only <queries> intent the way
             runtime resolution does. So the major UPI apps are also listed
             explicitly by package; the <intent> queries still cover the
             long tail of bank/fintech apps not named here. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi" android:host="pay"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <package android:name="com.phonepe.app"/>
        <package android:name="com.phonepe.app.preprod"/>
        <package android:name="com.google.android.apps.nbu.paisa.user"/>
        <package android:name="net.one97.paytm"/>
        <package android:name="in.org.npci.upiapp"/>
        <package android:name="in.amazon.mShop.android.shopping"/>
        <package android:name="com.dreamplug.androidapp"/>
        <package android:name="in.slice.android"/>
        <package android:name="com.tatadigital.tcp"/>
        <package android:name="com.mobikwik_new"/>
        <package android:name="com.freecharge.android"/>
        <package android:name="com.epifi.paisa"/>
        <package android:name="com.naviapp"/>
        <package android:name="money.jupiter"/>
        <package android:name="com.nextbillion.groww"/>
        <package android:name="com.whatsapp"/>
        <package android:name="com.samsung.android.spay"/>
        <package android:name="com.sbi.lotusintouch"/>
        <package android:name="com.sbi.upi"/>
        <package android:name="com.csam.icici.bank.imobile"/>
        <package android:name="com.icicibank.pockets"/>
        <package android:name="com.snapwork.hdfc"/>
        <package android:name="com.axis.mobile"/>
        <package android:name="com.axis.upiapp"/>
        <package android:name="com.bankofbaroda.mconnect"/>
        <package android:name="com.bankofbaroda.upi"/>
        <package android:name="com.msf.kbank.mobile"/>
        <package android:name="com.enstage.wibmo.hdfc"/>
        <package android:name="com.infrasofttech.UnionBankofIndia"/>
        <package android:name="com.fss.pnbpsp"/>
        <package android:name="com.YES_BANK"/>
        <package android:name="com.rblbank.mobank"/>
        <package android:name="com.idbibank.abhay_card"/>
        <package android:name="com.canarabank.mobility"/>
        <package android:name="com.olacabs.customer"/>
        <package android:name="com.myairtelapp"/>
        <package android:name="com.jio.myjio"/>
        <package android:name="com.whatsapp.w4b"/>
    </queries>
</manifest>
