<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- UA-4 (Chunk 30, extended): camera/QR card scanning (mobile_scanner,
         camera + google_mlkit_text_recognition). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- The `camera` plugin (specifically camera_android_camerax) declares
         three permissions this screen has no use for: RECORD_AUDIO and
         WRITE_EXTERNAL_STORAGE (its own manifest scopes this one to
         maxSdkVersion 28) for its video-recording mode, and — confirmed by
         building a real prod-release APK and reading
         manifest-merger-prod-release-report.txt, not assumed —
         READ_EXTERNAL_STORAGE as well. This screen only ever calls
         takePicture() with CameraController(enableAudio: false): no video,
         no microphone, no gallery read. Stripped rather than carried: an
         unused microphone/storage permission on a card-scanning screen is
         exactly what Play Store review flags, and it's what
         scripts/check_prod_manifest.sh's denylist exists to catch — it did,
         on the first build after this pass added the plugin. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- UA-5.3 (Chunk 31): SMS-based transaction auto-import. Permission
         plumbing + BroadcastReceiver declaration only — same "could not be
         verified on a real device in this sandbox" caveat as UA-4's camera
         permissions above (no Android SDK/emulator/real SMS here either).
         See PROGRESS.md Chunk 31. READ_SMS lets the app read existing/
         historical messages (used for an opt-in onboarding backfill scan);
         RECEIVE_SMS is what lets the telephony plugin's BroadcastReceiver
         fire on newly-arriving bank SMS while the app is foregrounded. -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <!-- UA-8 (Chunk 32): "check nearby merchants" geofencing. Originally
         foreground-only (FINE/COARSE); extended in a later pass to add
         optional background monitoring — an opt-in toggle in
         nearby_merchants_screen.dart, off by default, backed by
         GeofenceMonitorService's geolocator position stream. ACCESS_BACKGROUND_LOCATION
         and the foreground-service permissions below are ONLY exercised
         when the user explicitly turns that toggle on; the default
         one-shot flow still only needs FINE/COARSE. Same "could not
         verify granting on a real device" caveat as UA-4/UA-5.3 above —
         no Android SDK/emulator here either. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Android 13+ runtime notification permission — flutter_local_notifications
         needs this to actually post the background-geofence-match alert
         (and the required persistent foreground-service notification). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- UA-8.2 (Chunk 32): home-screen widget provider skeleton. Never
             built/run through a real Android toolchain in this sandbox — see
             BestCardWidgetProvider.kt and PROGRESS.md for exactly what is
             and isn't verified. -->
        <receiver android:name=".BestCardWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/best_card_widget_info" />
        </receiver>

        <!-- S2 (GAP_ANALYSIS.md §3): Quick Settings tile. Same "never built
             through a real Android toolchain in this sandbox" caveat as the
             widget receiver above — see BestCardTileService.kt. -->
        <service
            android:name=".BestCardTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="PandaPay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
