# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Flutter currently does not filter iOS dev-dependency plugins from the
# generated registrant. Keep dev-only pods (currently integration_test)
# available to Debug integration tests, while the Runner build phase guards
# their registration out of Profile/Release builds.
#
# Google ML Kit currently ships no arm64 iOS Simulator slice. The optional
# skipped_plugins list also lets us exercise the rest of PandaPay on an
# Apple-Silicon simulator without changing device builds.
def pandapay_install_ios_pods(application_path, skipped_plugins = [])
  flutter_install_ios_engine_pod(application_path)

  symlink_dir = File.expand_path('.symlinks', application_path)
  system('rm', '-rf', symlink_dir)
  symlink_plugins_dir = File.expand_path('plugins', symlink_dir)
  system('mkdir', '-p', symlink_plugins_dir)

  dependencies = flutter_parse_plugins_file(
    File.join(application_path, '..', '.flutter-plugins-dependencies'),
  )
  swift_package_manager_enabled = flutter_get_swift_package_manager_enabled(
    dependencies,
    'ios',
  )

  flutter_get_plugins_list(dependencies, 'ios').each do |plugin|
    name = plugin['name']
    path = plugin['path']
    next unless name && path && plugin.fetch('native_build', true)
    next if skipped_plugins.include?(name)

    symlink = File.join(symlink_plugins_dir, name)
    File.symlink(path, symlink)
    relative = flutter_relative_path_from_podfile(symlink)
    platform_directory = plugin.fetch('shared_darwin_source', false) ? 'darwin' : 'ios'
    podspec_directory = File.join(relative, platform_directory)
    swift_package_exists = File.exist?(File.join(podspec_directory, name, 'Package.swift'))
    next if swift_package_manager_enabled && swift_package_exists
    next if swift_package_exists && !File.exist?(File.join(podspec_directory, "#{name}.podspec"))

    # The test plugin must remain linked for `flutter drive` in Debug, but
    # CocoaPods otherwise embeds its framework into device Release apps too.
    if plugin.fetch('dev_dependency', false)
      pod name, path: podspec_directory, configurations: ['Debug']
    else
      pod name, path: podspec_directory
    end
  end
end

# Google ML Kit currently ships no arm64 iOS Simulator slice. Keeping this
# opt-in allows the rest of PandaPay to be exercised on an Apple-Silicon
# simulator without altering device builds. The scanner remains device-only
# during this validation mode.
def pandapay_install_simulator_plugin_pods(application_path)
  pandapay_install_ios_pods(
    application_path,
    %w[google_mlkit_commons google_mlkit_text_recognition rive_native],
  )
end

target 'Runner' do
  use_frameworks!

  ios_application_path = File.dirname(File.realpath(__FILE__))
  if ENV['PANDAPAY_SIMULATOR'] == '1'
    pandapay_install_simulator_plugin_pods(ios_application_path)
  else
    pandapay_install_ios_pods(ios_application_path)
  end
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

  end
end
