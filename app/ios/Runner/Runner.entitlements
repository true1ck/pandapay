<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group shared with HomeWidgetExtension — this is how the widget
	     reads what home_widget_service.dart writes via
	     HomeWidget.saveWidgetData. Must match HomeWidgetExtension's own
	     entitlements file and the group id passed to
	     HomeWidget.setAppGroupId() on the Dart side. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.pandapay.pandapay.homewidget</string>
	</array>
</dict>
</plist>
