# =====================================================
# PANDAPAY AUTH SERVICE - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to git (it's in .gitignore)
# =====================================================

# =====================================================
# DATABASE MODE SWITCH
# =====================================================
# Options: 'local' or 'aws'
# - 'local': Uses DATABASE_URL for local Docker PostgreSQL
# - 'aws': Uses AWS SSM Parameter Store for AWS PostgreSQL
# =====================================================
DATABASE_MODE=aws

# =====================================================
# LOCAL DATABASE CONFIGURATION
# =====================================================
# Only used when DATABASE_MODE=local
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password123@localhost:5433/pandapay_auth
# Verified TLS is the default for normal URLs and AWS SSM credentials. Set
# DB_SSL=false only for local development/test PostgreSQL, never production.
DB_SSL=false
# Local development is directly reachable, so ignore X-Forwarded-For. The
# production/staging Compose files set one trusted loopback-bound Nginx hop.
# Legacy TRUST_PROXY=true is temporarily supported as one hop only; prefer
# TRUST_PROXY_HOPS and never use an unbounded boolean trust setting.
TRUST_PROXY_HOPS=0
# Optional custom provider CA is added to Node's system trust roots. Set either
# DB_SSL_CA (PEM, escaped newlines accepted) or DB_SSL_CA_FILE.
# DB_SSL_CA_FILE=/run/secrets/provider-postgres-ca.pem

# =====================================================
# AWS DATABASE CONFIGURATION
# =====================================================
# Only used when DATABASE_MODE=aws
# These credentials are used ONLY to access AWS SSM Parameter Store
# Database credentials are fetched from SSM at runtime - NOT stored here

# AWS Region for SSM Parameter Store
AWS_REGION=ap-south-1

# AWS Access Key (for SSM access only)
AWS_ACCESS_KEY_ID=your_aws_access_key_here

# AWS Secret Key (for SSM access only)
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Optional: Control which database user to use
# false = use read_write_user from /test/livingai/db/app (default for auth service)
# true = use read_only_user from /test/livingai/db/app/readonly
DB_USE_READONLY=false

# Optional: Database connection settings (auto-detected if not set)
# DB_HOST=db.livingai.app
# DB_PORT=5432
# DB_NAME=livingai_test_db

# =====================================================
# JWT Configuration (REQUIRED for both modes)
# =====================================================
# These secrets are used to sign and verify JWT tokens
# Generate strong random secrets for production
JWT_ACCESS_SECRET=add74b258202057143382e8ee9ecc24a1114eddd3da5db79f3d29d24d7083043
JWT_REFRESH_SECRET=94a09772321fa15dc41c6c1e07d3b97a5b50d770e29f2ade47e8de5c571a611d

# Optional JWT settings
# Keep PHONE_LOOKUP_HMAC_KEY stable; changing it requires an explicit full reindex.
PHONE_LOOKUP_HMAC_KEY=generate-a-random-secret-at-least-32-bytes
# Backend-to-backend only. Never bundle this value in a mobile app or browser.
AUTH_INTERNAL_SERVICE_SECRET=generate-a-different-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=180d
REFRESH_MAX_IDLE_MINUTES=129600

# tokenService.js signs access tokens with a literal `aud: 'authenticated'`
# claim, but jwtKeys.js's claims validator defaults JWT_AUDIENCE to
# 'mobile-app' — a mismatch that makes every authMiddleware-protected route
# (GET/PUT /users/me, etc.) 401 with "Invalid token claims" unless this is
# set to match. Required for anything besides /auth/* to work.
JWT_AUDIENCE=authenticated

# =====================================================
# OTP abuse storage
# =====================================================
# Hosted production/staging always use PostgreSQL for OTP counters, active
# challenge markers, and replacement quotas. Do not set AUTH_ABUSE_STORE to
# memory in hosted environments. Development/test may explicitly use memory.
# The default PostgreSQL row capacity is 100000; this bounds rows, not bytes.
AUTH_ABUSE_BUCKET_CAPACITY=100000
# Optional actual PostgreSQL runtime role when a separate privileged migration
# identity creates the abuse table. Pooler usernames can differ from role names.
# AUTH_RUNTIME_ROLE=auth_runtime
# AUTH_ABUSE_STORE=memory

# =====================================================
# Redis Configuration (other legacy limiters)
# =====================================================
# REDIS_URL does not configure the OTP abuse store. Redis remains used by
# other legacy admin, user, and general-purpose rate limiters.
# For local development with Docker Compose:
REDIS_URL=redis://localhost:6379

# OR use separate host/port:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# For production (AWS ElastiCache, etc.):
# REDIS_URL=redis://your-redis-host:6379
# REDIS_URL=redis://:password@your-redis-host:6379

# =====================================================
# Application Configuration
# =====================================================
# Environment: development, production, test
NODE_ENV=development

# Server port
PORT=3000

# =====================================================
# CORS Configuration
# =====================================================
# For local development, you can leave empty (allows all origins)
# For production, REQUIRED - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Production example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://api.example.com

# =====================================================
# Twilio Configuration (Optional - for SMS OTP)
# =====================================================
# Uncomment and fill in if using Twilio for SMS OTP
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# SECURITY NOTES
# =====================================================
# 1. DO NOT commit this file - it's already in .gitignore
# 2. For AWS mode: Database credentials are fetched from SSM Parameter Store
#    SSM Parameter Paths:
#    - Read-Write User: /test/livingai/db/app
#    - Read-Only User: /test/livingai/db/app/readonly
# 
#    SSM Parameter Format (JSON):
#    {
#      "user": "read_write_user",
#      "password": "secure_password_here",
#      "host": "db.livingai.app",
#      "port": "5432",
#      "database": "livingai_test_db"
#    }
# 
# 3. For local mode: Use DATABASE_URL with local PostgreSQL
#    Start PostgreSQL with: docker-compose up -d postgres (from db/farmmarket-db/)
# 
# 4. Replace all placeholder values with your actual credentials
# 5. Use strong random secrets for JWT_ACCESS_SECRET and JWT_REFRESH_SECRET


# Stop creation after identity proof; existing account sign-in/recovery stays available.
# Explicit true/false only. Operator activation requires an accepted rollout.
NEW_ACCOUNT_REGISTRATIONS_PAUSED=false
