  "residuals": {
    "flipkart-axis-bank-credit-card": {
      "merchant_pattern": "flipkart",
      "why": "The Flipkart 5% rule is v2-only since WP7 round 1 (its except list keeps Flipkart Health out, which v1 cannot express, C8 D16c), so its Rs4,000-per-quarter cap is hidden from v1 too. v1 now pays the 1% base on Flipkart, uncapped. Before WP7 it paid 5% until Rs4,000 cashback a quarter (Rs80,000 of spend), then 0 (issuer: no cashback past the cap). v1 pays less until the quarter's Flipkart spend passes Rs4 lakh and more after it; per spend, it shows 1% where the issuer pays 0 once Rs80,000 is spent. A v1-only cap (or rule) needs max_engine_version on cap_rules.",
      "routed_to": "lead (C8 D29c)"
    }
  }
}
