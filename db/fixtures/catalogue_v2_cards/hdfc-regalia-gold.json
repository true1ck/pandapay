      "overrides_applied": [
        {
          "path": "reward_rules[id=select_brand_5x].conditions.payment_requirement",
          "op": "remove",
          "value_sha256": "74234e98afe7498f",
          "reason": "WP7: T&C: \"payment must be done directly using HDFC Bank Regalia Gold Credit Card\"; a wallet payment reaches the card as a wallet load (excluded), never as the brand, so the merchant list already enforces it. Removing it lets the 5X rule load (was info).",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/regalia-gold-credit-card/pdfs/regalia-gold-credit-card-reward-points-t-and-cs.pdf",
          "checked_on": "2026-11-05",
          "citation": null
        },
        {
          "path": "reward_rules[id=select_brand_5x].action.points_per_block",
          "op": "set",
          "value_sha256": "b7a56873cd771f2c",
          "reason": "WP7: The loader reads points_per_block as the full rule rate. T&C: 5X on the four brands with \"Base reward points ... continue as is\"; 5X of the 5 RP/Rs200 base is 25 RP/Rs200 (100 base + 400 incremental on Rs4,000 in the worked example).",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/regalia-gold-credit-card/pdfs/regalia-gold-credit-card-reward-points-t-and-cs.pdf",
          "checked_on": "2026-11-05",
          "citation": null
        },
        {
          "path": "reward_rules[id=select_brand_5x].conditions.minimum_transaction_inr",
          "op": "set",
          "value_sha256": "27badc983df1780b",
          "reason": "WP7: T&C: \"Minimum transaction value to be eligible for offer or reward points is Rs. 200.\"",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/regalia-gold-credit-card/pdfs/regalia-gold-credit-card-reward-points-t-and-cs.pdf",
          "checked_on": "2026-11-05",
          "citation": null
        },
        {
          "path": "reward_rules",
          "op": "append",
          "value_sha256": "b75fcb9574c9b415",
          "reason": "WP7: D28c: Reward Points T&C item 4: \"EasyEMI and e-wallet loading transactions will not accrue Reward points\". The record's EMI row needs category emi AND rail emi, so an EMI purchase in another category earned. Rail-EMI exclusion on all spend.",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/regalia-gold-credit-card/pdfs/regalia-gold-credit-card-reward-points-t-and-cs.pdf",
          "checked_on": "2026-11-05",
          "citation": null
        },
        {
          "path": "reward_rules[id=education_direct_standard].depends_on_txn_attribute",
          "op": "set",
          "value_sha256": "b5bea41b6c623f7c",
          "reason": "Card data review: MITC v4.18 (Oct 2026) I: \"Education payments made through third-party apps like (but not limited to) CRED, Cheq, MobiKwik, etc will not earn Reward Points\"; charges t: education \"done directly through ... their POS machines\" is not charged. Whether a payment went direct or through an app is not in the transaction context (the platform is never known for SMS spends, and an unknown platform cannot prove 'direct'), so this base-rate rule stays info with the D14b deferral flag. The education exclusion (category education, all channels) governs: direct education payments are under-stated, never over-stated.",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/personal-mitc/mitc-in-english.pdf",
          "checked_on": "2026-11-06",
          "citation": null
        },
        {
          "path": "reward_rules",
          "op": "append",
          "value_sha256": "86a8d96d60d7e56e",
          "reason": "Card data review: D24d. MITC v4.18 (Oct 2026) I(g): \"With effect from 1st July 2025, Online Skill-Based gaming transactions will not earn Reward Points/CashPoints on all the cards.\" The record had no gaming row. Same token as the Diners Black Metal record: v1-only entertainment row (D18b) plus a v2 MCC 5816 row.",
          "source_url": "https://www.hdfc.bank.in/content/dam/hdfcbankpws/in/en/personal-banking/discover-products/cards/credit-cards/personal-mitc/mitc-in-english.pdf",
          "checked_on": "2026-11-06",
          "citation": null
        }
      ]
