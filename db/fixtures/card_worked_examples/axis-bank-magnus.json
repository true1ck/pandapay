      "item": "cap accelerated_spend_cap",
      "cardpipeline_says": "limit_value and limit_value_inr both null",
      "issuer_says": "Ceiling is the cardholder assigned credit limit + Rs 1.5 lakh per calendar month, so it cannot be a static catalogue number.",
      "proposed_fix": "engine: per-user ceiling needs the card limit; until then the 35x band is unbounded (over-states for very high spend)",
      "override_file": null
    },
    {
      "item": "structure of 35x",
      "cardpipeline_says": "base rule capped at Rs 1.5 lakh then falls to a separate 35 accelerator",
      "issuer_says": "Base 12 per Rs 200 is credited on all eligible spend; the accelerated part adds 23 per Rs 200 on cumulative eligible spend above Rs 1.5 lakh and is credited ~45 days after month end.",
      "proposed_fix": "none: equivalent total, modelled with an eligible-spend cap and a custom post-cap rate of 35 per Rs 200",
      "override_file": null
    },
