    {
      "item": "Card data review (2026-11-06): cap window",
      "cardpipeline_says": "1,000 CashPoints per calendar month for each of 5% and 1%.",
      "issuer_says": "The T&C table header says 'Maximum CashBack / CashPoints per Cycle', but both detailed sections say 'in a calendar month' and posting is on a calendar-month basis. Kept as calendar month.",
      "proposed_fix": "none"
    },
    {
      "item": "Card data review (2026-11-06): gift cards and vouchers",
