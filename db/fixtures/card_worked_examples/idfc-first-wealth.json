  "research_notes": [
    {
      "item": "rounding",
      "cardpipeline_says": "rounding_mode floor",
      "issuer_says": "The issuer pages state 1X = 1 point per Rs 200 but not how a partial block is treated; examples use whole blocks.",
      "proposed_fix": "none",
      "override_file": null
    },
    {
      "item": "block size and 10X structure",
      "cardpipeline_says": "base_block_inr 150; 3X up to Rs 20,000 per cycle then 10X on incremental spend above Rs 20,000; rent/education/wallet/government earn 3X",
      "issuer_says": "Current issuer page: 1X = 1 point per Rs 200; 10X on dining, travel, international and birthday spends from the first transaction (no minimum); 3X on all other eligible categories; 1X on insurance, utilities, railway, FASTag. There is no Rs 20,000 threshold.",
      "proposed_fix": "override",
      "override_file": "api/scripts/catalogue_overrides/idfc-first-wealth.json"
    },
    {
      "item": "fuel / EMI / cash / fees on Wealth",
      "cardpipeline_says": "fuel_exclusion, emi_exclusion, cash_withdrawal_exclusion, fee_charge_exclusion",
      "issuer_says": "Wealth FAQ states: no reward point on EMI, cash withdrawal, fuel, fee and charges. Override restates all four.",
      "proposed_fix": "override",
      "override_file": "api/scripts/catalogue_overrides/idfc-first-wealth.json"
    },
    {
      "item": "railway and FASTag 1X vs 10X travel",
      "cardpipeline_says": "railway_1x / fastag_1x priority 20 (Select copy: 22/23) behind 10X travel priority 11",
      "issuer_says": "Issuer: 1X on insurance, utilities, railway spends and FASTag recharge. The override gives these priorities 5-8 and MCCs (rail 4112, toll 4784) so they beat 10X travel.",
      "proposed_fix": "override",
      "override_file": "api/scripts/catalogue_overrides/idfc-first-wealth.json"
    },
    {
      "item": "international and birthday 10X",
      "cardpipeline_says": "international_spend / birthday_spend accelerators",
      "issuer_says": "Needs a foreign-currency flag / the cardholder birthday. Set to info (flag depends_on_txn_attribute / depends_on_user_attribute); never ranked in Phase 1.",
      "proposed_fix": "override",
      "override_file": "api/scripts/catalogue_overrides/idfc-first-wealth.json"
    },
    {
      "item": "in-app hotel/flight bonus",
      "cardpipeline_says": "not in the Wealth source",
      "issuer_says": "Issuer page: 20% bonus points on hotel and 10% on flight bookings through the IDFC FIRST mobile app, up to 8000 bonus (monthly per the Select terms). It needs a booking-channel flag, so the rules are not added; no cap is restored and no cap_reference points at it.",
      "proposed_fix": "none",
      "override_file": null
    },
    {
      "item": "limit-based cap",
      "cardpipeline_says": "cap_rules empty",
