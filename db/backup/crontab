# The backup container runs scheduled encrypted paired exports only.
# It needs PRODUCT_DATABASE_URL, AUTH_DATABASE_URL, BACKUP_AGE_RECIPIENTS_FILE,
# BACKUP_DESTINATION_A/B, BACKUP_DIR and RETENTION_DAYS from its environment.
# The mounted destinations must be separate off-host storage locations.
15 2 * * * /backup/backup.sh >> /proc/1/fd/1 2>> /proc/1/fd/2

# Restore drills intentionally run from a separately controlled recovery host
# that holds RESTORE_AGE_IDENTITY_FILE and explicit RESTORE_* database URLs.
# Do not mount a private age identity or source DB credentials into this cron
# container. Schedule restore_drill.sh on that recovery host instead.
