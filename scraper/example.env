# Copy to .env and fill in. Never commit the real .env.

# IMPORTANT: must be scraper_role, not postgres — see db/setup_scraper_role.sql
# for why (BYPASSRLS is deliberate and narrowly scoped here, unlike the
# postgres-superuser bug found in api/ during an earlier session).
SCRAPER_DATABASE_URL=postgresql://scraper_role:scraper_dev_pw@localhost:55432/pandapay

# --- AD-4.3 real-LLM extraction (optional) ---
# Both are optional. Without ANTHROPIC_API_KEY, extraction falls back to the
# deterministic heuristic-regex extractor (extraction.py) automatically — no
# other config needed and no behavior change from before this feature existed.
#
# ANTHROPIC_API_KEY=sk-ant-...
#
# EXTRACTION_MODE controls which extraction path runs:
#   auto      (default) — use the LLM if ANTHROPIC_API_KEY is set, else heuristic
#   llm       — always attempt the LLM call (falls back to heuristic on error);
#               logs a warning and falls back if ANTHROPIC_API_KEY isn't set
#   heuristic — always use the regex heuristic, even if a key is present
#               (for cost control)
# EXTRACTION_MODE=auto
