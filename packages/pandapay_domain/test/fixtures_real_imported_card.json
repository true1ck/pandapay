  "extended_data": {
    "schema_version": "5.0.0",
    "additional_data": {
      "items": [
        {
          "key": "cashback_caps_effective_2026_04_01",
          "source": "https://www.sbicard.com/cashback-revised\n",
          "description": "From 1 April 2026, online cashback is capped at \u20b92,000 per statement cycle, offline/POS cashback is capped at \u20b92,000 per statement cycle, and aggregate cashback is capped at \u20b94,000 per statement cycle."
        },
        {
          "key": "cashback_posting_basis",
          "source": "https://www.sbicard.com/en/faq/cashback-sbi-card-faq.page\n",
          "description": "Cashback accrues on the transaction posting/settlement date rather than the effective transaction date, using the cashback structure applicable when the transaction posts."
        },
        {
          "key": "cashback_forfeiture_and_closure",
          "source": "https://www.sbicard.com/sbi-card-en/assets/docs/pdf/cashback-tnc-booklet.pdf\n",
          "description": "If the card is voluntarily closed, earned cashback may be redeemed within 30 days of closure; otherwise it lapses. On cancellation for another reason, earned cashback is forfeited. Cashback is also forfeited following more than 90 days of payment delinquency, settlement of outstanding dues, fraud determined by SBICPSL, or specified regulatory events."
        },
        {
          "key": "cashback_network_identification",
          "source": "https://www.sbicard.com/sbi-card-en/assets/docs/pdf/cashback-tnc-booklet.pdf\n",
          "description": "Online transactions are identified using online indicators sent by card networks and the acquirer; transactions not categorized as online are treated as offline. Network MCC definitions may change."
        },
        {
          "key": "education_payment_fee_detail",
          "source": "https://www.sbicard.com/en/most-important-terms-and-conditions.page\n",
          "description": "From 1 November 2025, education payments through third-party apps such as CRED, Cheq and MobiKwik attract a 1% fee. Direct payments to colleges or schools through their websites or POS machines do not attract this fee. Education MCCs identified on a best-effort basis are 8211, 8220, 8241, 8244, 8249 and 8299."
        },
        {
          "key": "wallet_load_fee_detail",
          "source": "https://www.sbicard.com/en/most-important-terms-and-conditions.page\n",
          "description": "From 1 November 2025, a 1% fee applies to every wallet load transaction exceeding \u20b91,000. Wallet transactions are identified under MCCs 6540 and 6541 on a best-effort basis."
        },
        {
          "key": "rent_payment_fee_detail",
          "source": "https://www.sbicard.com/en/most-important-terms-and-conditions.page\n",
