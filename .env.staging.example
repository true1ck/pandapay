# Copy to `.env.staging` next to docker-compose.staging.yml and fill in.
# NEVER commit the real file — covered by .gitignore's `/.env.staging` entry.
#
# Use DIFFERENT values from `.env` (prod) for every secret below — staging
# and prod must never share a JWT signing secret or a database. The whole
# point of staging is that a mistake here can't touch real user data.

ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-staging-db-host:5432/pandapay
APP_USER_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD
API_DATABASE_URL=postgresql://app_user:CHANGE_ME_SAME_AS_APP_USER_PASSWORD@your-staging-db-host:5432/pandapay
REWARD_WORKER_DB_PASSWORD=CHANGE_ME_GENERATE_A_DISTINCT_REAL_PASSWORD
REWARD_WORKER_DATABASE_URL=postgresql://rewards_worker_login:CHANGE_ME_SAME_AS_REWARD_WORKER_DB_PASSWORD@your-staging-db-host:5432/pandapay
# Opt-in: blank keeps the autonomous SMS learner disabled.
SMS_LEARNING_WORKER_DB_PASSWORD=
AUTH_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-staging-db-host:5432/pandapay_auth
DB_SSL=true
DB_POOL_MAX=10
OTP_WORK_MAX_CONCURRENT=2
OTP_EMAIL_MAX_CONCURRENT=2
OTP_SMS_MAX_CONCURRENT=2
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
SEED_DEMO_DATA=true

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_DIFFERENT_FROM_PROD
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_DIFFERENT_FROM_PROD
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=180d
REFRESH_MAX_IDLE_MINUTES=129600
JWT_ISSUER=pandapay-auth
JWT_AUDIENCE=mobile-app
AUTH_INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
# Stable within staging, different from production. Rotation requires reindexing.
PHONE_LOOKUP_HMAC_KEY=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
# Maximum auth OTP-abuse bucket rows. Hosted auth always uses PostgreSQL;
# this row limit does not cap physical database bytes or bloat.
# Do not set AUTH_ABUSE_STORE=memory in this hosted environment.
AUTH_ABUSE_BUCKET_CAPACITY=100000
REFERRAL_IDENTITY_HMAC_KEY=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REFERRAL_IDENTITY_HMAC_KEY_VERSION=v1
REFERRAL_PREVIEW_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
ENGAGEMENT_RECEIPT_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REWARD_WORKER_INTERNAL_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REWARD_WORKER_ID=referral-worker-staging-1
REWARD_WORKER_POLL_INTERVAL_MS=5000
REWARD_WORKER_BATCH_SIZE=5
REWARD_WORKER_LEASE_SECONDS=90
PRODUCT_TERMS_VERSION=2026-08-07
# Optional rotation set. If present, use the same JSON and active key id in
# both api and auth; JWT_ACCESS_SECRET remains the legacy fallback.
# JWT_ACTIVE_KEY_ID=1
# JWT_KEYS_JSON='{"1":"CHANGE_ME_CURRENT_ACCESS_SECRET","2":"CHANGE_ME_PREVIOUS_ACCESS_SECRET"}'

CORS_ALLOWED_ORIGINS=https://staging-console.your-domain.example
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_BASE64_KEY_DIFFERENT_FROM_PROD
# Optional read-only versioned field keys; leave blank unless provisioned.
# JSON array of [nonsecret-key-id, base64-32-byte-key] pairs; max 8.
# The original ENCRYPTION_KEY and current legacy writes remain unchanged.
# Legacy phone writes remain the default. Do not replace ENCRYPTION_KEY.
# Enable versioned writes only after all readers/key custody/restore acceptance;
# select an existing ID in ENCRYPTION_READ_KEYS_JSON (new key bytes stay private).
ENCRYPTION_V2_WRITES_ENABLED=false
ENCRYPTION_WRITE_KEY_ID=
ENCRYPTION_READ_KEYS_JSON=

# Same Gmail-SMTP setup as .env.prod.example — EMAIL_PASS is a Gmail "App
# Password" (myaccount.google.com/apppasswords), not the account password.
# Using the SAME Gmail account as prod is fine here (it's just where the
# mail comes from, not a security boundary) but consider a distinct
# EMAIL_FROM or subject prefix if staging OTP emails ever confuse a tester.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=CHANGE_ME_GMAIL_APP_PASSWORD_16_CHARS
EMAIL_FROM="PandaPay Staging <your-account@gmail.com>"
ENABLE_PHONE_OTP=false
ENABLE_EMAIL_OTP=true

INBOUND_EMAIL_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
PARTNER_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
IMAP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_KEY

# Private lightweight notification service used for FCM delivery.
NOTIFICATION_SERVICE_URL=https://staging-notifications.example.com
NOTIFICATION_SERVICE_API_KEY=CHANGE_ME_NOTIFICATION_PROJECT_API_KEY
NOTIFICATION_SERVICE_TIMEOUT_MS=4000

BACKUP_RETENTION_DAYS=7

# Optional: Google Places API (New) key. Seamlessly falls back to OpenStreetMap when unset.
GOOGLE_PLACES_API_KEY=
# Autonomous SMS learning is enabled when both values are configured and the
# sms-learning profile is started. Use the dedicated non-superuser DB role.
SMS_LEARNING_HMAC_KEY=
SMS_LEARNING_DATABASE_URL=
# Optional bootstrap password for the dedicated worker DB login.
SMS_LEARNING_WORKER_DB_PASSWORD=
# Example when enabled: postgresql://sms_learning_worker:CHANGE_ME_SAME_AS_SMS_LEARNING_WORKER_DB_PASSWORD@your-staging-db-host:5432/pandapay
SMS_LEARNING_WORKER_ROLE=sms_learning_worker
SMS_AUTONOMOUS_WORKER_INTERVAL_MS=300000


# Security recovery foundation (host-only configuration; retain existing keys).
# System trust is used unless your provider needs an additional public PEM CA.
# Docker Compose accepts a quoted PEM with literal \n sequences here.
DB_SSL_CA=
# Match the source PG major; pg_dump cannot export from a newer server.
POSTGRES_CLIENT_MAJOR=17
# Optional separate privileged auth migration URL; falls back to AUTH_DATABASE_URL.
AUTH_MIGRATION_DATABASE_URL=
# Optional exact PostgreSQL role used by auth at runtime. Set this only when
# different from the migration principal; it receives DML on auth abuse buckets.
AUTH_RUNTIME_ROLE=
# Optional access auditing stays off until access and bounded retention are reviewed.
DB_ACCESS_LOGGING_ENABLED=false
# Legacy checksum adoption requires independent schema/history review first.
MIGRATION_ADOPT_LEGACY_CHECKSUMS=false
MIGRATION_LEGACY_BASELINE_FILE=
# Absolute host paths. Both destinations must be independently hosted mounts,
# verified by the operator; local folders are not off-host recovery.
BACKUP_AGE_RECIPIENTS_FILE=/absolute/path/public-backup-recipients.txt
BACKUP_DESTINATION_A=/absolute/path/offhost-mount-a
BACKUP_DESTINATION_B=/absolute/path/offhost-mount-b

# Per location: at most 7 complete pairs, 1 GiB including in-flight ciphertext.
# Stop before free space drops below 512 MiB or disk usage exceeds 85%.
# Measure the actual auth server and encrypted pair size before deployment.
BACKUP_MAX_SETS=7
BACKUP_MAX_BYTES=1073741824
BACKUP_MIN_FREE_BYTES=536870912
BACKUP_MAX_USAGE_PERCENT=85

# Optional isolated callback login. Blank leaves callback unavailable (503).
# Generate a new dedicated credential; never reuse the app/admin DB login.
PARTNER_WEBHOOK_DATABASE_URL=
PARTNER_WEBHOOK_DB_PASSWORD=
# Optional recovery-machine status publisher login; not an API credential.
BACKUP_STATUS_WRITER_DB_PASSWORD=
# Dashboard stays disabled until an operator grants a specific UUID + expiry.
ENABLE_ADMIN_DASHBOARD=false

# Opt-in IMAP worker; use a direct/session-affine DB URL, never transaction pooling.
# IMAP_ENCRYPTION_KEY keeps its original value; this is a separate DB credential.
IMAP_POLL_DATABASE_URL=
IMAP_WORKER_DB_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=0

# Optional same-origin console browser session (retained 32-byte base64 key).
# Serve console and /browser from one HTTPS origin; add it to CORS allowlist.
CONSOLE_BROWSER_ENABLED=false
CONSOLE_BROWSER_ORIGIN=
CONSOLE_SESSION_DATABASE_URL=
CONSOLE_SESSION_ENCRYPTION_KEY=
CONSOLE_SESSION_DB_PASSWORD=
# Durable account denial requires dedicated roles and an explicit DB release gate.
ACCOUNT_LIFECYCLE_ENABLED=false
ACCOUNT_LIFECYCLE_DATABASE_URL=
AUTH_LIFECYCLE_DATABASE_URL=
ACCOUNT_LIFECYCLE_DB_PASSWORD=
AUTH_LIFECYCLE_DB_PASSWORD=
ACCOUNT_LIFECYCLE_POLL_INTERVAL_MS=0
# Explicitly consented phone-only recovery; never add a password prompt.
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_RECOVERY_WRAPPING_KEY=
ACCOUNT_RECOVERY_WRAPPING_KEY_ID=
# Optional retained unwrap keys, same pair-array grammar; excludes active ID.
# Keep original key custody/escrow; this does not enable recovery or rotate.
ACCOUNT_RECOVERY_WRAPPING_READ_KEYS_JSON=

# Lifecycle external denial journal: provision TWO private mounted roots and
# a separate retained authentication key, stable 64-hex ID, age public recipient.
# No key is generated by startup. Container image must include reviewed age.
ACCOUNT_LIFECYCLE_JOURNAL_A=
ACCOUNT_LIFECYCLE_CHECKPOINT_ROOT=
ACCOUNT_LIFECYCLE_JOURNAL_B=
ACCOUNT_LIFECYCLE_JOURNAL_ID=
ACCOUNT_LIFECYCLE_JOURNAL_AUTH_KEY=
ACCOUNT_LIFECYCLE_JOURNAL_RECIPIENTS_FILE=
ACCOUNT_LIFECYCLE_JOURNAL_AGE_BINARY=age

# Retire only after accepted six-digit clients and compatibility window.
AUTH_RETIRE_LEGACY_OTP=false
AUTH_RETIRE_PUBLIC_LOOKUP=false

# Bounded maintenance: explicit policy, capability logins and acceptance first.
MAINTENANCE_ENABLED=false
MAINTENANCE_DATABASE_URL=
MAINTENANCE_DB_PASSWORD=
MAINTENANCE_READER_DB_PASSWORD=
AUTH_RETENTION_MAINTENANCE_ENABLED=false
AUTH_MAINTENANCE_DATABASE_URL=
AUTH_MAINTENANCE_DB_PASSWORD=
AUTH_RETENTION_DATABASE_URL=
AUTH_DB_ACCESS_LOG_RETENTION_DAYS=
AUTH_ABUSE_STATE_RETENTION_DAYS=
AUTH_RETENTION_BATCH_SIZE=100
AUTH_RETENTION_MAX_BATCHES=10
AUTH_RETENTION_MAX_DURATION_MS=5000

# Optional maintenance-notice delivery. No sender or receiver is provisioned.
# Requires separate exact-candidate receiver/TLS/idempotency acceptance.
MAINT_ALERT_DELIVERY_ENABLED=false
MAINT_ALERT_SOURCE_ID=
MAINT_ALERT_READER_DATABASE_URL=
MAINT_ALERT_DB_SSL_CA=
MAINT_ALERT_DB_SSL_CA_FILE=
MAINT_ALERT_WEBHOOK_URL=
MAINT_ALERT_WEBHOOK_HOSTS=
MAINT_ALERT_DELIVERY_STATE=

# Requires typed sync schema and financial-state acceptance; keep disabled until rollout.
SYNC_TYPED_WRITES_ENABLED=false

# Stop creation after identity proof; existing account sign-in/recovery stays available.
# Explicit true/false only. Operator activation requires an accepted rollout.
NEW_ACCOUNT_REGISTRATIONS_PAUSED=false

# Default-off source capabilities; enable only after schema/role/provider acceptance.
# Use distinct least-privilege logins (never the app/admin URL) and budget 1 slot each.
# Keep the HMAC key stable across replicas/restarts; record its version, not its bytes.
SHARED_FEEDBACK_ADMISSION_ENABLED=false
SHARED_FEEDBACK_DATABASE_URL=
SHARED_FEEDBACK_HMAC_KEY=
NOTIFICATION_OUTBOX_ENABLED=false
NOTIFICATION_OUTBOX_DATABASE_URL=

# Schema-first immutable result receipts; required before resumable import UX.
# Default off until request/replay/old-client/restore acceptance is recorded.
STATEMENT_IMPORT_RECEIPTS_ENABLED=false

# Optional read-only operator probe; never supplied to the public API runtime.
# Separate notification_monitor_runtime login inherits only notification_monitor.
# Budget its one connection in the reviewed physical-cluster monitor inventory.
NOTIFICATION_MONITOR_DATABASE_URL=
