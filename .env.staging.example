# Copy to `.env.staging` next to docker-compose.staging.yml and fill in.
# NEVER commit the real file — covered by .gitignore's `/.env.staging` entry.
#
# Use DIFFERENT values from `.env` (prod) for every secret below — staging
# and prod must never share a JWT signing secret or a database. The whole
# point of staging is that a mistake here can't touch real user data.

ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-staging-db-host:5432/pandapay
APP_USER_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD
API_DATABASE_URL=postgresql://app_user:CHANGE_ME_SAME_AS_APP_USER_PASSWORD@your-staging-db-host:5432/pandapay
AUTH_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-staging-db-host:5432/pandapay_auth
DB_SSL=true
SEED_DEMO_DATA=true

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_DIFFERENT_FROM_PROD
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET_DIFFERENT_FROM_PROD
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ALLOWED_ORIGINS=https://staging-console.your-domain.example
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_BASE64_KEY_DIFFERENT_FROM_PROD

# Same Gmail-SMTP setup as .env.prod.example — EMAIL_PASS is a Gmail "App
# Password" (myaccount.google.com/apppasswords), not the account password.
# Using the SAME Gmail account as prod is fine here (it's just where the
# mail comes from, not a security boundary) but consider a distinct
# EMAIL_FROM or subject prefix if staging OTP emails ever confuse a tester.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=CHANGE_ME_GMAIL_APP_PASSWORD_16_CHARS
EMAIL_FROM="PandaPay Staging <your-account@gmail.com>"
ENABLE_PHONE_OTP=false
ENABLE_EMAIL_OTP=true

INBOUND_EMAIL_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
PARTNER_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
IMAP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_KEY

BACKUP_RETENTION_DAYS=7
