# nginx reverse proxy for auth/ — same pattern as api.conf.example, copy to
# /etc/nginx/sites-available/auth.your-domain.example.
#
# auth/ only listens on 127.0.0.1:3210 (docker-compose.prod.yml).
#
# Requires request-id-map.conf.example to also be installed (see that file
# and deploy/DEPLOY.md) — it defines $req_id, used below. A code review
# caught that this file used to omit X-Request-Id entirely, even though
# auth/src/observability.js's requestLogger reuses an inbound one exactly
# like api/'s does — auth/ traffic through nginx got no forwarded id at all.

server {
    listen 80;
    listen [::]:80;
    server_name auth.your-domain.example;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.your-domain.example;

    ssl_certificate     /etc/letsencrypt/live/auth.your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.your-domain.example/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 1m;

    # OTP request/verify endpoints get hit hardest and are the most sensitive
    # to being proxy-buffered/delayed — kept on the same short timeout as
    # everything else here, called out only because it's the endpoint an
    # outage would be most visible on.
    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $req_id;
    }
}
