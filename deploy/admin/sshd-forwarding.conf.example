# Operator must validate with sshd -t and keep a recovery session before reload.
# Dedicated account/key only; never apply this Match block to a deploy account.
Match User pandapay-admin-forward
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:4321
    PermitListen none
    MaxSessions 0
    PermitTTY no
    AllowAgentForwarding no
    X11Forwarding no
    PermitUserRC no
    PermitTunnel no
    GatewayPorts no
