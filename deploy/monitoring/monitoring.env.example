# Monitoring VM settings. Copy to `.env` next to compose.monitoring.yml and
# `chmod 600 .env`. Generate every secret fresh; never reuse app secrets.

# This VM's Tailscale IP (tailscale ip -4). Every UI listens only here.
PRIVATE_BIND_IP=100.64.0.10

# Public hostname for error-report ingestion only (DNS A record -> this VM).
ERRORS_HOSTNAME=errors.pandapath.live

# openssl rand -hex 32
GLITCHTIP_SECRET_KEY=
# openssl rand -hex 24
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_FROM_EMAIL=alerts@pandapath.live
# Optional, for GlitchTip's own alert emails: smtp+tls://user:pass@smtp.example.com:587
GLITCHTIP_EMAIL_URL=

# openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
