          },
          "expr": "sum by (job, outcome) (increase(error_reports_total[15m]))",
          "legendFormat": "{{job}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
