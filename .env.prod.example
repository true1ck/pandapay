# Copy to `.env` next to docker-compose.prod.yml and fill in every value.
# NEVER commit the real `.env` — it is covered by .gitignore's `/.env` entry,
# double-check with `git status` before your first commit on a new checkout.
#
# See deploy/DEPLOY.md for how each of these gets generated/provisioned.

# ── Database ─────────────────────────────────────────────────────────────
# One Postgres instance, two databases — `pandapay` (api/) and
# `pandapay_auth` (auth/) — same arrangement as docker-compose.yml's local
# dev setup, just pointed at a real host. All three URLs below can point at
# the same host/instance with different db names and roles.

# Superuser (or equivalently privileged) role. Used ONLY by db-migrate (to
# create app_user and apply grants) and by the backup service (pg_dump/
# pg_restore need privileges app_user is deliberately never granted — see
# db/setup_app_role.sql). Never used by api/ or auth/ themselves.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-db-host:5432/pandapay

# Generated once, fed to db-migrate, which creates the app_user role with it.
# Must be a real random value — db/scripts/migrate.sh refuses to run without
# this set, specifically so the committed dev password can't reach anywhere
# with real user data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_USER_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD

# api/'s own connection — app_user, RLS-bound, never postgres (see
# api/example.env's header for why a superuser here silently disables RLS).
API_DATABASE_URL=postgresql://app_user:CHANGE_ME_SAME_AS_APP_USER_PASSWORD@your-db-host:5432/pandapay

# auth/'s own database — separate database, same instance is fine.
AUTH_DATABASE_URL=postgresql://postgres:CHANGE_ME@your-db-host:5432/pandapay_auth

DB_SSL=true

# Skip demo catalogue/card seed data in anything real.
SEED_DEMO_DATA=false

# ── JWT (must match exactly between api/ and auth/) ────────────────────────
# api/src/auth.js verifies auth/'s tokens by signature only — both services
# must be configured with the identical secret or every request 401s.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_REAL_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── auth/ CORS ───────────────────────────────────────────────────────────
# Comma-separated, no wildcard. auth/src/config.js refuses to start in
# production without this set. Only relevant for any browser-based client
# (e.g. the admin console) — the mobile app itself sends no Origin header.
CORS_ALLOWED_ORIGINS=https://console.your-domain.example

ENCRYPTION_ENABLED=true
# The actual key ENCRYPTION_ENABLED needs — without this, auth/'s field
# encryption (phone numbers etc.) silently no-ops (a stderr warning, nothing
# else) rather than failing loudly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_BASE64_KEY

# ── OTP delivery: email via Gmail SMTP, no SMS provider ─────────────────
# auth/src/services/emailService.js uses nodemailer against any generic SMTP
# host, Gmail included. Without EMAIL_HOST/USER/PASS set, it silently falls
# back to logging the OTP code to the container's stdout instead of sending
# it — harmless in dev, useless in production (no real user will ever see
# that log).
#
# EMAIL_PASS must be a Gmail "App Password", NOT your normal Gmail login
# password — Google disabled plain-password SMTP auth for regular accounts
# in 2022. Requires 2-Step Verification turned on for the Gmail account,
# then generate one at https://myaccount.google.com/apppasswords (16
# characters, no spaces when you paste it here).
#
# Free Gmail accounts are capped at ~500 sent messages/day (2000/day on
# Google Workspace) — fine for early-stage OTP volume, a real limit to know
# about before it's the reason a signup silently doesn't get its code.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=CHANGE_ME_GMAIL_APP_PASSWORD_16_CHARS
EMAIL_FROM="PandaPay <your-account@gmail.com>"

# No Twilio/SMS provider configured — phone-based OTP is disabled so a user
# can't start a signup that can never receive its code. Flip this to "true"
# only once a real SMS provider is wired into auth/src/services/smsService.js
# (or equivalent) and its credentials are set below it — not before, or a
# phone-number signup will look like it worked and then never deliver a code.
ENABLE_PHONE_OTP=false
ENABLE_EMAIL_OTP=true

# ── api/ webhook & encryption secrets ───────────────────────────────────
# Shared secret an inbound-email provider (SendGrid/Mailgun/Postmark/a
# Cloudflare Email Worker) must present to POST /inbound-emails/webhook.
INBOUND_EMAIL_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Shared secret for the partner/affiliate webhook.
PARTNER_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# pgp_sym_decrypt key for stored IMAP app passwords (F7). Must be a real
# random value, not the dev literal — api/src/imap_test.js falls back to a
# format-only check when this is unset, which is not acceptable outside dev.
IMAP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_KEY

# ── Backups ──────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
