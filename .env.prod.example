# Copy to `.env` next to docker-compose.prod.yml and fill in every value.
# NEVER commit the real `.env` — it is covered by .gitignore's `/.env` entry,
# double-check with `git status` before your first commit on a new checkout.
#
# See deploy/DEPLOY.md for how each of these gets generated/provisioned.

# ── Database ─────────────────────────────────────────────────────────────
# One Postgres instance, two databases — the default `postgres` db (api/)
# and `pandapay_auth` (auth/, created via `CREATE DATABASE pandapay_auth;`
# against the admin URL) — same two-databases-one-instance arrangement as
# docker-compose.yml's local dev setup, just pointed at a real host.
#
# Verified against a real Supabase free-tier project: `postgres` role has
# createdb+createrole (not full superuser, which free-tier Supabase doesn't
# grant — fine, we never needed rolsuper, just those two). Live-tested the
# full chain: db/scripts/migrate.sh, app_user creation, api/'s catalogue
# route, and auth/'s OTP-request write path all worked end to end.
#
# Supabase specifics if that's your host:
#   - Free tier's DIRECT connection is IPv6-only (no IPv4 add-on on Free).
#     Use the SESSION POOLER connection instead (host is
#     aws-<n>-<region>.pooler.supabase.com, still port 5432) — it's IPv4-
#     proxied for free. Don't use the Transaction pooler (port 6543) for
#     ADMIN_DATABASE_URL — migrations/CREATE ROLE want session semantics.
#   - Through the pooler, the username MUST be `<role>.<project-ref>`, e.g.
#     `postgres.chgkmvmoqehbgkccrqbs` or `app_user.chgkmvmoqehbgkccrqbs` —
#     a bare role name gets rejected with "no tenant identifier provided".
#   - Free tier caps ACTIVE projects at 2 per org — that's why this uses ONE
#     Supabase project with two databases in it, not two separate projects.
#   - Supabase's free tier does NOT include automated backups — the
#     `backup`/`restore_drill` services in this compose file are not
#     optional here the way they might be against a provider with built-in
#     PITR.

# Superuser-equivalent role (createdb+createrole). Used ONLY by db-migrate
# (to create app_user and apply grants) and by the backup service (pg_dump/
# pg_restore need privileges app_user is deliberately never granted — see
# db/setup_app_role.sql). Never used by api/ or auth/ themselves.
ADMIN_DATABASE_URL=postgresql://postgres.CHANGE_ME_PROJECT_REF:CHANGE_ME@aws-0-CHANGE_ME_REGION.pooler.supabase.com:5432/postgres

# Generated once, fed to db-migrate, which creates the app_user role with it.
# Must be a real random value — db/scripts/migrate.sh refuses to run without
# this set, specifically so the committed dev password can't reach anywhere
# with real user data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_USER_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD

# Separate low-privilege DB login used only by the durable rewards worker.
# Keep its password distinct from APP_USER_PASSWORD and use this exact value
# in both the role-creation migration environment and the worker connection.
REWARD_WORKER_DB_PASSWORD=CHANGE_ME_GENERATE_A_DISTINCT_REAL_PASSWORD
REWARD_WORKER_DATABASE_URL=postgresql://rewards_worker_login.CHANGE_ME_PROJECT_REF:CHANGE_ME_SAME_AS_REWARD_WORKER_DB_PASSWORD@aws-0-CHANGE_ME_REGION.pooler.supabase.com:5432/postgres

# Dedicated non-superuser login for the autonomous SMS learner. Opt-in: leave
# blank to keep the worker disabled (no dedicated role is bootstrapped); when
# enabling it, set a distinct real generated password matching the one embedded
# in SMS_LEARNING_DATABASE_URL below.
SMS_LEARNING_WORKER_DB_PASSWORD=

# api/'s own connection — app_user, RLS-bound, never postgres (see
# api/example.env's header for why a superuser here silently disables RLS).
# Username is app_user.<project-ref> through the pooler — see note above.
API_DATABASE_URL=postgresql://app_user.CHANGE_ME_PROJECT_REF:CHANGE_ME_SAME_AS_APP_USER_PASSWORD@aws-0-CHANGE_ME_REGION.pooler.supabase.com:5432/postgres

# auth/'s own database — separate database, same project/instance is fine.
# The deploy migration runner applies auth/db/migrations through this URL too,
# so it must retain DDL privileges on pandapay_auth (the example postgres role
# has them). The auth service itself uses this URL at runtime as configured.
AUTH_DATABASE_URL=postgresql://postgres.CHANGE_ME_PROJECT_REF:CHANGE_ME@aws-0-CHANGE_ME_REGION.pooler.supabase.com:5432/pandapay_auth

DB_SSL=true
DB_POOL_MAX=10
# Per auth process; immediate 503 on saturation, no in-memory wait queue.
# Complements shared abuse quotas; benchmark before changing (integer 1..16).
OTP_WORK_MAX_CONCURRENT=2
OTP_EMAIL_MAX_CONCURRENT=2
OTP_SMS_MAX_CONCURRENT=2
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Skip demo catalogue/card seed data in anything real.
SEED_DEMO_DATA=false

# ── JWT (must match exactly between api/ and auth/) ────────────────────────
# api/src/auth.js verifies auth/'s tokens with the shared key set and the
# issuer/audience contract — both services must use identical JWT settings.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_REAL_SECRET
JWT_ACCESS_TTL=15m
# Keep a rolling session for active users; sign-in is only required after 90 days unused.
JWT_REFRESH_TTL=180d
REFRESH_MAX_IDLE_MINUTES=129600
JWT_ISSUER=pandapay-auth
JWT_AUDIENCE=mobile-app
AUTH_INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
# Stable phone-lookup HMAC key. Changing it requires reindexing auth phone hashes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_LOOKUP_HMAC_KEY=CHANGE_ME_GENERATE_A_STABLE_32_BYTE_SECRET
# Maximum auth OTP-abuse bucket rows. Hosted auth always uses PostgreSQL;
# this row limit does not cap physical database bytes or bloat.
# Do not set AUTH_ABUSE_STORE=memory in this hosted environment.
AUTH_ABUSE_BUCKET_CAPACITY=100000
REFERRAL_IDENTITY_HMAC_KEY=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REFERRAL_IDENTITY_HMAC_KEY_VERSION=v1
REFERRAL_PREVIEW_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
ENGAGEMENT_RECEIPT_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REWARD_WORKER_INTERNAL_SECRET=CHANGE_ME_GENERATE_A_DISTINCT_32_BYTE_SECRET
REWARD_WORKER_ID=referral-worker-prod-1
REWARD_WORKER_POLL_INTERVAL_MS=5000
REWARD_WORKER_BATCH_SIZE=5
REWARD_WORKER_LEASE_SECONDS=90
PRODUCT_TERMS_VERSION=2026-08-07
# Optional rotation set. If present, use the same JSON and active key id in
# both api and auth; JWT_ACCESS_SECRET remains the legacy fallback.
# JWT_ACTIVE_KEY_ID=1
# JWT_KEYS_JSON='{"1":"CHANGE_ME_CURRENT_ACCESS_SECRET","2":"CHANGE_ME_PREVIOUS_ACCESS_SECRET"}'

# ── auth/ CORS ───────────────────────────────────────────────────────────
# Comma-separated, no wildcard. auth/src/config.js refuses to start in
# production without this set. Only relevant for any browser-based client
# (e.g. the admin console) — the mobile app itself sends no Origin header.
CORS_ALLOWED_ORIGINS=https://console.your-domain.example

ENCRYPTION_ENABLED=true
# Retain the original key across upgrades and provider moves. Hosted auth
# startup fails if this key is missing or invalid. For new installations only:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_BASE64_KEY
# Optional read-only versioned field keys; leave blank unless provisioned.
# JSON array of [nonsecret-key-id, base64-32-byte-key] pairs; max 8.
# The original ENCRYPTION_KEY and current legacy writes remain unchanged.
ENCRYPTION_READ_KEYS_JSON=

# ── OTP delivery: email via Gmail SMTP, no SMS provider ─────────────────
# auth/src/services/emailService.js uses nodemailer against any generic SMTP
# host, Gmail included. Without EMAIL_HOST/USER/PASS set, it silently falls
# back to logging the OTP code to the container's stdout instead of sending
# it — harmless in dev, useless in production (no real user will ever see
# that log).
#
# EMAIL_PASS must be a Gmail "App Password", NOT your normal Gmail login
# password — Google disabled plain-password SMTP auth for regular accounts
# in 2022. Requires 2-Step Verification turned on for the Gmail account,
# then generate one at https://myaccount.google.com/apppasswords (16
# characters, no spaces when you paste it here).
#
# Free Gmail accounts are capped at ~500 sent messages/day (2000/day on
# Google Workspace) — fine for early-stage OTP volume, a real limit to know
# about before it's the reason a signup silently doesn't get its code.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=CHANGE_ME_GMAIL_APP_PASSWORD_16_CHARS
EMAIL_FROM="PandaPay <your-account@gmail.com>"

# No Twilio/SMS provider configured — phone-based OTP is disabled so a user
# can't start a signup that can never receive its code. Flip this to "true"
# only once a real SMS provider is wired into auth/src/services/smsService.js
# (or equivalent) and its credentials are set below it — not before, or a
# phone-number signup will look like it worked and then never deliver a code.
ENABLE_PHONE_OTP=false
ENABLE_EMAIL_OTP=true

# ── api/ webhook & encryption secrets ───────────────────────────────────
# Shared secret an inbound-email provider (SendGrid/Mailgun/Postmark/a
# Cloudflare Email Worker) must present to POST /inbound-emails/webhook.
INBOUND_EMAIL_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Shared secret for the partner/affiliate webhook.
PARTNER_WEBHOOK_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# pgp_sym_decrypt key for stored IMAP app passwords (F7). Must be a real
# random value, not the dev literal — api/src/imap_test.js falls back to a
# format-only check when this is unset, which is not acceptable outside dev.
IMAP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_REAL_32_BYTE_KEY

# ── SMS intelligence Gemini worker (optional, server-side only) ───────────
# Leave both provider credentials blank to keep AI queue acceptance disabled.
# To enable, configure BOTH values. Generate a separate worker token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store GEMINI_API_KEY in the host secret store where possible. It is passed
# only to the opt-in worker container; it is never sent to the mobile app.
AI_WORKER_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_TOKENS_PER_MINUTE=12000
AI_WORKER_INTERVAL_MS=2000
AI_WORKER_BATCH_MAX=4
AI_WORKER_BATCH_WINDOW_MS=300
AI_PROVIDER_TIMEOUT_MS=20000
# Optional shared-learning HMAC secret. Cross-user signals are additionally
# gated by each profile's contributions_opt_in preference (off by default).
SMS_LEARNING_HMAC_KEY=
# Dedicated narrowly privileged product-DB URL used only by the autonomous SMS
# learner. Leave blank to disable the worker; when enabled, the password must
# equal SMS_LEARNING_WORKER_DB_PASSWORD.
SMS_LEARNING_DATABASE_URL=
# Example when enabled: postgresql://sms_learning_worker.CHANGE_ME_PROJECT_REF:CHANGE_ME_SAME_AS_SMS_LEARNING_WORKER_DB_PASSWORD@aws-0-CHANGE_ME_REGION.pooler.supabase.com:5432/postgres
SMS_LEARNING_WORKER_ROLE=sms_learning_worker
SMS_AUTONOMOUS_WORKER_INTERVAL_MS=300000

# Private lightweight notification service used for FCM delivery.
NOTIFICATION_SERVICE_URL=https://novu-notifications-test.onrender.com
NOTIFICATION_SERVICE_API_KEY=CHANGE_ME_NOTIFICATION_PROJECT_API_KEY
NOTIFICATION_SERVICE_APP_ID=PANDAPAY
NOTIFICATION_SERVICE_TIMEOUT_MS=4000
NOTIFICATION_SERVICE_FCM_INTEGRATION_IDENTIFIER=
NOTIFICATION_SERVICE_WORKFLOW_IDENTIFIER=pandapay-push-notification
NOTIFICATION_SERVICE_WORKFLOW_NAME=PandaPay push notification
NOTIFICATION_SERVICE_WORKFLOW_GROUP_ID=

# ── Backups ──────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7

# ── Nearby Places Discovery ───────────────────────────────────────────────
# Optional: Google Places API (New) key. When unset or quota exceeded,
# nearby discovery seamlessly falls back to OpenStreetMap / Overpass API.
GOOGLE_PLACES_API_KEY=


# Security recovery foundation (host-only configuration; retain existing keys).
# System trust is used unless your provider needs an additional public PEM CA.
# Docker Compose accepts a quoted PEM with literal \n sequences here.
DB_SSL_CA=
# Match the source PG major; pg_dump cannot export from a newer server.
POSTGRES_CLIENT_MAJOR=17
# Optional separate privileged auth migration URL; falls back to AUTH_DATABASE_URL.
AUTH_MIGRATION_DATABASE_URL=
# Optional exact PostgreSQL role used by auth at runtime. Set this only when
# different from the migration principal; it receives DML on auth abuse buckets.
AUTH_RUNTIME_ROLE=
# Optional access auditing stays off until access and bounded retention are reviewed.
DB_ACCESS_LOGGING_ENABLED=false
# Legacy checksum adoption requires independent schema/history review first.
MIGRATION_ADOPT_LEGACY_CHECKSUMS=false
MIGRATION_LEGACY_BASELINE_FILE=
# Absolute host paths. Both destinations must be independently hosted mounts,
# verified by the operator; local folders are not off-host recovery.
BACKUP_AGE_RECIPIENTS_FILE=/absolute/path/public-backup-recipients.txt
BACKUP_DESTINATION_A=/absolute/path/offhost-mount-a
BACKUP_DESTINATION_B=/absolute/path/offhost-mount-b

# Per location: at most 7 complete pairs, 1 GiB including in-flight ciphertext.
# Stop before free space drops below 512 MiB or disk usage exceeds 85%.
# Measure the actual auth server and encrypted pair size before deployment.
BACKUP_MAX_SETS=7
BACKUP_MAX_BYTES=1073741824
BACKUP_MIN_FREE_BYTES=536870912
BACKUP_MAX_USAGE_PERCENT=85

# Optional isolated callback login. Blank leaves callback unavailable (503).
# Generate a new dedicated credential; never reuse the app/admin DB login.
PARTNER_WEBHOOK_DATABASE_URL=
PARTNER_WEBHOOK_DB_PASSWORD=
# Optional recovery-machine status publisher login; not an API credential.
BACKUP_STATUS_WRITER_DB_PASSWORD=
# Dashboard stays disabled until an operator grants a specific UUID + expiry.
ENABLE_ADMIN_DASHBOARD=false

# Opt-in IMAP worker; use a direct/session-affine DB URL, never transaction pooling.
# IMAP_ENCRYPTION_KEY keeps its original value; this is a separate DB credential.
IMAP_POLL_DATABASE_URL=
IMAP_WORKER_DB_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=0

# Optional same-origin console browser session (retained 32-byte base64 key).
# Serve console and /browser from one HTTPS origin; add it to CORS allowlist.
CONSOLE_BROWSER_ENABLED=false
CONSOLE_BROWSER_ORIGIN=
CONSOLE_SESSION_DATABASE_URL=
CONSOLE_SESSION_ENCRYPTION_KEY=
CONSOLE_SESSION_DB_PASSWORD=
# Durable account denial requires dedicated roles and an explicit DB release gate.
ACCOUNT_LIFECYCLE_ENABLED=false
ACCOUNT_LIFECYCLE_DATABASE_URL=
AUTH_LIFECYCLE_DATABASE_URL=
ACCOUNT_LIFECYCLE_DB_PASSWORD=
AUTH_LIFECYCLE_DB_PASSWORD=
ACCOUNT_LIFECYCLE_POLL_INTERVAL_MS=0
# Explicitly consented phone-only recovery; never add a password prompt.
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_RECOVERY_WRAPPING_KEY=
ACCOUNT_RECOVERY_WRAPPING_KEY_ID=
# Optional retained unwrap keys, same pair-array grammar; excludes active ID.
# Keep original key custody/escrow; this does not enable recovery or rotate.
ACCOUNT_RECOVERY_WRAPPING_READ_KEYS_JSON=

# Lifecycle external denial journal: provision TWO private mounted roots and
# a separate retained authentication key, stable 64-hex ID, age public recipient.
# No key is generated by startup. Container image must include reviewed age.
ACCOUNT_LIFECYCLE_JOURNAL_A=
ACCOUNT_LIFECYCLE_CHECKPOINT_ROOT=
ACCOUNT_LIFECYCLE_JOURNAL_B=
ACCOUNT_LIFECYCLE_JOURNAL_ID=
ACCOUNT_LIFECYCLE_JOURNAL_AUTH_KEY=
ACCOUNT_LIFECYCLE_JOURNAL_RECIPIENTS_FILE=
ACCOUNT_LIFECYCLE_JOURNAL_AGE_BINARY=age

# Retire only after accepted six-digit clients and compatibility window.
AUTH_RETIRE_LEGACY_OTP=false
AUTH_RETIRE_PUBLIC_LOOKUP=false

# Bounded maintenance: explicit policy, capability logins and acceptance first.
MAINTENANCE_ENABLED=false
MAINTENANCE_DATABASE_URL=
MAINTENANCE_DB_PASSWORD=
MAINTENANCE_READER_DB_PASSWORD=
AUTH_RETENTION_MAINTENANCE_ENABLED=false
AUTH_MAINTENANCE_DATABASE_URL=
AUTH_MAINTENANCE_DB_PASSWORD=
AUTH_RETENTION_DATABASE_URL=
AUTH_DB_ACCESS_LOG_RETENTION_DAYS=
AUTH_ABUSE_STATE_RETENTION_DAYS=
AUTH_RETENTION_BATCH_SIZE=100
AUTH_RETENTION_MAX_BATCHES=10
AUTH_RETENTION_MAX_DURATION_MS=5000

# Optional maintenance-notice delivery. No sender or receiver is provisioned.
# Requires separate exact-candidate receiver/TLS/idempotency acceptance.
MAINT_ALERT_DELIVERY_ENABLED=false
MAINT_ALERT_SOURCE_ID=
MAINT_ALERT_READER_DATABASE_URL=
MAINT_ALERT_DB_SSL_CA=
MAINT_ALERT_DB_SSL_CA_FILE=
MAINT_ALERT_WEBHOOK_URL=
MAINT_ALERT_WEBHOOK_HOSTS=
MAINT_ALERT_DELIVERY_STATE=

# Requires typed sync schema and financial-state acceptance; keep disabled until rollout.
SYNC_TYPED_WRITES_ENABLED=false
